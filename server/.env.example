# Copy to .env and fill in. .env is gitignored — never commit the real values.

# Neon: the POOLED connection string, from the Neon dashboard.
# Looks like: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Cloudflare R2 — an API token scoped to Object Read & Write on this one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=a-box-for-you

# Browser origins allowed to call the API. Local dev default shown.
BOX_ALLOWED_ORIGINS=http://localhost:5173
